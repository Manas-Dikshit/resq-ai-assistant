# ─── Client-side variables ───────────────────────────────────────────────────
# Only VITE_* values are exposed to the browser bundle. Never put server secrets
# in this file. Copy this file to .env and fill in your own project values.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# Optional: NASA FIRMS active-fire hotspots.
# Register free at https://firms.modaps.eosdis.nasa.gov/usfs/api/area/
VITE_NASA_FIRMS_API_KEY="YOUR_FIRMS_MAP_KEY_HERE"

# Optional: CARTO basemap key. A public fallback key is used when unset.
VITE_CARTO_API_KEY="YOUR_CARTO_API_KEY_HERE"

# ─── Server-side secrets (set with `supabase secrets set`, not in .env) ──────
# LOVABLE_API_KEY=...        # required by resqai-chat
# ML_MODEL_URL=...           # optional external model for predict-risk
